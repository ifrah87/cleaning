<?xml version="1.0" encoding="utf-8"?>
<!-- Drawn rather than drawn-in-Photoshop: a solid board-coloured ground with the app
     icon sat in the middle of it. A PNG here would be one more thing that has to be
     re-exported whenever the icon changes, and would drift out of step the first time
     nobody remembered to. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/tv_ground" />
    </shape>
  </item>
  <item
      android:gravity="center"
      android:width="96dp"
      android:height="96dp">
    <bitmap android:src="@mipmap/ic_launcher" android:gravity="center" />
  </item>
</layer-list>
